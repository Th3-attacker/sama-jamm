{
  "expo": {
    "name": "Sama Jàmm",
    "slug": "sama-jamm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "samajamm",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.samajamm.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f7f7f5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.samajamm.app",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "allowBackup": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f7f7f5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#12161b"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pour calculer vos horaires de prière et la direction de la qibla sur ce téléphone."
        }
      ],
      "expo-notifications",
      "expo-background-task",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Pour déverrouiller votre budget avec Face ID. Rien ne quitte ce téléphone."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "40baf6c7-a3b9-418d-b7b1-d258fcc829b1"
      }
    }
  }
}
