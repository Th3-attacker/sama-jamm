{
  "expo": {
    "name": "Sama Jàmm",
    "slug": "sama-jamm",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/40baf6c7-a3b9-418d-b7b1-d258fcc829b1"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "samajamm",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.samajamm.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1f5f4a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.samajamm.app",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      "./plugins/android-sans-ondulation.js",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f7f7f5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0f1714",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pour calculer vos horaires de prière et la direction de la qibla sur ce téléphone."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1f5f4a",
          "defaultChannel": "rappels-v1",
          "sounds": [
            "./assets/sons/adhan_fajr.mp3",
            "./assets/sons/adhan_fajr_court.mp3",
            "./assets/sons/adhan_makkah.mp3",
            "./assets/sons/adhan_makkah_court.mp3",
            "./assets/sons/adhan_fajr_complet_ios.wav",
            "./assets/sons/adhan_fajr_court_ios.wav",
            "./assets/sons/adhan_makkah_complet_ios.wav",
            "./assets/sons/adhan_makkah_court_ios.wav"
          ]
        }
      ],
      "expo-background-task",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Pour déverrouiller votre budget avec Face ID. Rien ne quitte ce téléphone."
        }
      ],
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "40baf6c7-a3b9-418d-b7b1-d258fcc829b1"
      }
    }
  }
}
